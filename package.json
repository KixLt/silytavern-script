{
  "name": "silytavern-script",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "酒馆助手 (JS-Slash-Runner) 脚本集合",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "pnpm -r --sort run build",
    "typecheck": "pnpm -r --sort run typecheck",
    "dev": "pnpm --filter @silytavern/plot-progress-bar run dev",
    "dev:build": "pnpm --filter @silytavern/plot-progress-bar run dev:build"
  }
}
